generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Role {
  roleId       BigInt    @id @default(autoincrement()) @map("role_id")
  roleName     String    @map("role_name") @db.NVarChar(100)
  description  String?   @db.NVarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime2
  createdBy    BigInt?   @map("created_by")
  updatedAt    DateTime? @map("updated_at") @db.DateTime2
  updatedBy    BigInt?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at") @db.DateTime2
  deletedBy    BigInt?   @map("deleted_by")
  users        User[]

  @@map("roles")
}

model User {
  userId         BigInt         @id @default(autoincrement()) @map("user_id")
  username       String         @db.NVarChar(100)
  passwordHash   String         @map("password_hash") @db.NVarChar(255)
  email          String         @db.NVarChar(255)
  phone          String?        @db.NVarChar(20)
  fullName       String         @map("full_name") @db.NVarChar(255)
  avatarUrl      String?        @map("avatar_url") @db.NVarChar(500)
  roleId         BigInt         @map("role_id")
  isActive       Boolean        @default(true) @map("is_active")
  lastLoginAt    DateTime?      @map("last_login_at") @db.DateTime2
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime2
  createdBy      BigInt?        @map("created_by")
  updatedAt      DateTime?      @map("updated_at") @db.DateTime2
  updatedBy      BigInt?        @map("updated_by")
  deletedAt      DateTime?      @map("deleted_at") @db.DateTime2
  deletedBy      BigInt?        @map("deleted_by")
  role           Role           @relation(fields: [roleId], references: [roleId])
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  studentProfile Student?
  lecturerProfile Lecturer?

  @@map("users")
}

model RefreshToken {
  id                String        @id @db.UniqueIdentifier
  userId            BigInt        @map("user_id")
  tokenHash         String        @map("token_hash") @db.NVarChar(500)
  expiresAt         DateTime      @map("expires_at") @db.DateTime2
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime2
  revokedAt         DateTime?     @map("revoked_at") @db.DateTime2
  replacedByTokenId String?       @map("replaced_by_token_id") @db.UniqueIdentifier
  deviceName        String?       @map("device_name") @db.NVarChar(255)
  ipAddress         String?       @map("ip_address") @db.NVarChar(64)
  userAgent         String?       @map("user_agent") @db.NVarChar(1024)
  revokedReason     String?       @map("revoked_reason") @db.NVarChar(500)
  createdByIp       String?       @map("created_by_ip") @db.NVarChar(64)
  user              User          @relation(fields: [userId], references: [userId])
  replacedByToken   RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacesTokens    RefreshToken[] @relation("RefreshTokenReplacement")

  @@map("refresh_tokens")
}

model AuditLog {
  logId       BigInt    @id @default(autoincrement()) @map("log_id")
  userId      BigInt?   @map("user_id")
  action      String    @db.NVarChar(100)
  entityType  String?   @map("entity_type") @db.NVarChar(100)
  entityId    String?   @map("entity_id") @db.NVarChar(100)
  oldValues   String?   @map("old_values") @db.NVarChar(Max)
  newValues   String?   @map("new_values") @db.NVarChar(Max)
  ipAddress   String?   @map("ip_address") @db.NVarChar(64)
  userAgent   String?   @map("user_agent") @db.NVarChar(1024)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime2
  user        User?     @relation(fields: [userId], references: [userId])

  @@map("audit_logs")
}

model Lecturer {
  lecturerId    BigInt    @id @default(autoincrement()) @map("lecturer_id")
  lecturerCode  String    @map("lecturer_code") @db.NVarChar(50)
  fullName      String    @map("full_name") @db.NVarChar(255)
  email         String?   @db.NVarChar(255)
  phone         String?   @db.NVarChar(20)
  departmentId  BigInt    @map("department_id")
  userId        BigInt?   @unique(map: "UX_lecturers_user_active") @map("user_id")
  academicTitle String?   @map("academic_title") @db.NVarChar(100)
  degree        String?   @db.NVarChar(100)
  specialization String?  @db.NVarChar(255)
  position      String?   @db.NVarChar(100)
  joinDate      DateTime? @map("join_date") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime2
  createdBy     BigInt?   @map("created_by")
  updatedAt     DateTime? @map("updated_at") @db.DateTime2
  updatedBy     BigInt?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at") @db.DateTime2
  deletedBy     BigInt?   @map("deleted_by")
  user          User?     @relation(fields: [userId], references: [userId])

  @@map("lecturers")
}

model Student {
  studentId       BigInt    @id @default(autoincrement()) @map("student_id")
  studentCode     String    @map("student_code") @db.NVarChar(50)
  fullName        String    @map("full_name") @db.NVarChar(255)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          String?   @db.NVarChar(20)
  email           String?   @db.NVarChar(255)
  phone           String?   @db.NVarChar(20)
  address         String?   @db.NVarChar(500)
  majorId         BigInt    @map("major_id")
  academicYearId  BigInt    @map("academic_year_id")
  advisorId       BigInt?   @map("advisor_id")
  userId          BigInt?   @unique(map: "UX_students_user_active") @map("user_id")
  adminClassId    BigInt?   @map("admin_class_id")
  facultyId       BigInt?   @map("faculty_id")
  cohortYear      Int?      @map("cohort_year")
  lastWarningSent DateTime? @map("last_warning_sent") @db.DateTime2
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime2
  createdBy       BigInt?   @map("created_by")
  updatedAt       DateTime? @map("updated_at") @db.DateTime2
  updatedBy       BigInt?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at") @db.DateTime2
  deletedBy       BigInt?   @map("deleted_by")
  user            User?     @relation(fields: [userId], references: [userId])

  @@map("students")
}
